# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,weekstory.local

# Database
DATABASE_URL=postgresql://weekstory_user:weekstory_secure_password@db:5432/weekstory
DB_NAME=weekstory
DB_USER=weekstory_user
DB_PASSWORD=weekstory_secure_password
DB_HOST=db
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# AI Models
TRANSFORMERS_CACHE=/app/models/transformers
TORCH_HOME=/app/models/torch
MODEL_NER=dslim/bert-base-multilingual-cased-ner
MODEL_SUMMARIZATION=facebook/bart-large-cnn
MODEL_TEXT_GENERATION=gpt2
OLLAMA_API_URL=http://localhost:11434

# Social Media APIs - Twitter/X
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# Social Media APIs - LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Social Media APIs - Instagram
INSTAGRAM_USERNAME=your-instagram-username
INSTAGRAM_PASSWORD=your-instagram-password

# Social Media APIs - Facebook
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# Sentry (Error Tracking)
SENTRY_DSN=

# Timezone
TIME_ZONE=UTC

# Feature Flags
ENABLE_AI_EXTRACTION=True
ENABLE_SOCIAL_POSTING=True
CONFIDENCE_THRESHOLD=0.75
MAX_STORY_LENGTH=10000
MAX_EXTRACTION_LENGTH=500

# Logging
LOG_LEVEL=INFO
